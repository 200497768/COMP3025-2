<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#396a93"
    tools:context=".MainActivity">
        <!-- App title -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="20sp"
        android:text="@string/weather"
        android:textColor="@color/white"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        <!-- Action buttons: Show example city and Choose another city -->
    <LinearLayout
        android:id="@+id/actionsArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20sp"
        android:background="#396a93"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent">
        <Button
            android:id="@+id/chooseCityButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_example_city"
            android:textSize="14sp" />
        <Button
            android:id="@+id/chooseAnotherCityButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose another city"
            android:textSize="14sp" />
        <!-- LOGOFF button removed — sign out is now in the bottom navigation bar.
             Kept as a hidden zero-size view so Java code referencing it does not crash. -->
        <Button
            android:id="@+id/logoffButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
        <!-- Fragment container fills the space between buttons and the bottom navigation bar -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#396a93"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/actionsArea" />
        <!-- Bottom navigation bar: Search / Saved / Sign Out -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#2a5070"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- Hidden legacy TextView kept for layout reference compatibility -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>

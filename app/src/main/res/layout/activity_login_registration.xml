<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/bg1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:orientation="vertical">

            <!-- GLASS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded"
                android:padding="24dp"
                android:orientation="vertical"
                android:elevation="6dp">

                <!-- TITLE -->
                <TextView
                    android:id="@+id/loginRegistrationActivityTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="6dp"/>

                <!-- SUBTITLE -->
                <TextView
                    android:id="@+id/loginRegistrationActivityInformationTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="loginRegistrationActivityInformationTextView"
                    android:textSize="14sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginBottom="20dp"/>

                <!-- TOGGLE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- LOGIN -->
                    <Button
                        android:id="@+id/loginButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:alpha="1"/>

                    <!-- SIGN UP -->
                    <Button
                        android:id="@+id/registrationButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/registration_fragment"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:alpha="0.5"/>

                </LinearLayout>

                <!-- EMAIL FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#22FFFFFF"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📧"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email address"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:textColor="@android:color/white"
                        android:textColorHint="#CCFFFFFF"
                        android:background="@null"/>
                </LinearLayout>

                <!-- PASSWORD FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#22FFFFFF"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:textColor="@android:color/white"
                        android:textColorHint="#CCFFFFFF"
                        android:background="@null"/>
                </LinearLayout>

                <!-- CONFIRM PASSWORD -->
                <LinearLayout
                    android:id="@+id/confirmPasswordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="#22FFFFFF"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="16sp"
                            android:layout_marginEnd="8dp"/>

                        <EditText
                            android:id="@+id/confirmPasswordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Confirm password"
                            android:inputType="textPassword"
                            android:textColor="@android:color/white"
                            android:textColorHint="#CCFFFFFF"
                            android:background="@null"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- ACTION BUTTON -->
                <Button
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="actionButton"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:backgroundTint="@color/primary"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"/>

                <!-- LOADING -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- ERROR -->
                <TextView
                    android:id="@+id/errorTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF8080"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</layout>